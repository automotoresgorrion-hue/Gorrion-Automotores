
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'ZJY8d4caLraTfqJ5aFRxwtPW8Or1';
    }

    // ==========================================
    // VEHÍCULOS
    // ==========================================

    match /vehiculos/{vehiculoId} {

      // El administrador puede leer todo.
      // El público solo puede leer vehículos disponibles.
      allow read: if isAdmin()
        || resource.data.estado == 'disponible';

      allow create: if isAdmin()
        && request.resource.data.estado == 'disponible'
        && request.resource.data.tipo in [
          'auto',
          'camioneta',
          'moto'
        ]
        && request.resource.data.marca is string
        && request.resource.data.modelo is string
        && request.resource.data.fotos is list
        && request.resource.data.fotos.size() <= 8;

      allow update: if isAdmin()
        && request.resource.data.estado in [
          'disponible',
          'vendido'
        ];

      allow delete: if isAdmin();
    }

    // ==========================================
    // MARCAS PERSONALIZADAS
    // ==========================================

    match /marcasPersonalizadas/{marcaId} {

      // Solo el administrador puede consultar las marcas.
      allow read: if isAdmin();

      // Solo el administrador puede guardar marcas nuevas
      // o actualizar una marca ya existente.
      allow create, update: if isAdmin()
        && request.resource.data.tipo in [
          'auto',
          'camioneta',
          'moto'
        ]
        && request.resource.data.marca is string
        && request.resource.data.marca.size() > 0;

      allow delete: if isAdmin();
    }
  }
}
